labs.jpasc.uk {
    reverse_proxy duanelabs-ui:80
}


https://labs.jpasc.uk:8443 {
    handle /backhouse/* {
        header Access-Control-Allow-Origin "https://labs.jpasc.uk"
        header Access-Control-Allow-Credentials "true"
        reverse_proxy mediamtx:8888
    }

    handle /fronthouse/* {
        header Access-Control-Allow-Origin "https://labs.jpasc.uk"
        header Access-Control-Allow-Credentials "true"
        reverse_proxy mediamtx:8888
    }

    handle {
        respond "Not found" 404
    }
}
